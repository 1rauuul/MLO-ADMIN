# Secreto de Payload (obligatorio). Genera uno con:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=

# Sin DATABASE_URL el proyecto usa SQLite local (mlo-admin.db) y no necesita nada más.
# Con DATABASE_URL usa Postgres (Supabase). La app va por el pooler; las migraciones por la conexión directa.
# DATABASE_URL=postgresql://postgres.<ref>:<pass>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL_DIRECT=

# Opcional: ruta del archivo SQLite local.
# SQLITE_URL=file:./mlo-admin.db
